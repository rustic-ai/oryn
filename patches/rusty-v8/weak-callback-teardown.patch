+      callback.unregister();
+      assert!(registry.as_ref().borrow().entries.is_empty());
+      assert!(observed.upgrade().is_some());
+      drop(callback);
+      assert!(observed.upgrade().is_none());
+    }
+    // Equivalent to post-native-dispose annex destruction: callbacks can no
+    // longer run and their retained parameter allocation must be released.
+    drop(registry);
+    assert!(observed.upgrade().is_none());
+    }
+  }
