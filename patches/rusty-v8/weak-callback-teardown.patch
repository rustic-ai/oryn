 /// from a pointer. The fields are wrapped in [`Cell`] so they are modifiable by
 /// both the [`Weak`] and the finalization callbacks.
 pub struct WeakData<T> {
+  registry: RcWeak<RefCell<WeakCallbackRegistry>>,
+  second_pass_pending: Cell<bool>,
   pointer: Cell<Option<NonNull<T>>>,
   finalizer_id: Option<FinalizerId>,
   weak_dropped: Cell<bool>,
+}
+
+impl<T> WeakData<T> {
+  fn unregister(&self) {
+    if let Some(registry) = self.registry.upgrade() {
+      let entry = registry.borrow_mut().entries.remove(&(self as *const Self as usize));
+      drop(entry);
+    }
+  }
+}
+
+// An erased strong Rc keeps each V8 callback parameter alive. It is released
+// after reset, after the second pass, or after V8 disposal proves that no
+// callback can run. Type erasure avoids imposing a new T: 'static API bound.
+struct WeakCallbackOwner {
+  parameter: *const c_void,
+  reset: unsafe fn(*const c_void) -> bool,
+  release: unsafe fn(*const c_void),
+}
+impl Drop for WeakCallbackOwner {
+  fn drop(&mut self) { unsafe { (self.release)(self.parameter) }; }
+}
+#[derive(Default)]
+pub(crate) struct WeakCallbackRegistry {
+  entries: std::collections::HashMap<usize, WeakCallbackOwner>,
+}
+impl WeakCallbackRegistry {
+  fn register<T>(registry: &Rc<RefCell<Self>>, data: &Rc<WeakData<T>>) {
+    unsafe fn reset<T>(parameter: *const c_void) -> bool {
+      let data = unsafe { &*parameter.cast::<WeakData<T>>() };
+      if let Some(pointer) = data.pointer.take() {
+        unsafe { v8__Global__Reset(pointer.cast().as_ptr()) };
+      }
+      data.second_pass_pending.get()
+    }
+    unsafe fn release<T>(parameter: *const c_void) {
+      drop(unsafe { Rc::from_raw(parameter.cast::<WeakData<T>>()) });
+    }
+    let parameter = Rc::into_raw(data.clone()).cast::<c_void>();
+    registry.borrow_mut().entries.insert(parameter as usize,
+      WeakCallbackOwner { parameter, reset: reset::<T>, release: release::<T> });
+  }
+  pub(crate) fn reset_before_dispose(registry: &Rc<RefCell<Self>>) {
+    // No registry borrow survives a Reset or an owner destructor.
+    let entries = std::mem::take(&mut registry.borrow_mut().entries);
+    for (key, owner) in entries {
+      if unsafe { (owner.reset)(owner.parameter) } {
+        registry.borrow_mut().entries.insert(key, owner);
+      }
+    }
+  }
 }
 
