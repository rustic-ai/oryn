+    CHECK_NE(start, 0u);
+    CHECK_LE(max_byte_length_, std::numeric_limits<uintptr_t>::max() - start);
+    const uintptr_t end = start + max_byte_length_;
+    auto& registry = GetNativeWaitRanges();
+    std::lock_guard<std::mutex> lock(registry.mutex);
+    auto next = registry.ranges.lower_bound(start);
+    CHECK(next == registry.ranges.end() || end <= next->first);
+    if (next != registry.ranges.begin()) CHECK_LE(std::prev(next)->second.end, start);
+    registry.ranges.emplace(start, NativeWaitRange{end, this, delegate});
+  }
