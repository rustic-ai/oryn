+std::shared_ptr<v8::SharedMemoryWaitDelegate> BackingStore::LookupSharedWaitDelegate(
+    void* address, size_t* offset) {
+  auto& registry = GetNativeWaitRanges();
+  std::lock_guard<std::mutex> lock(registry.mutex);
+  const uintptr_t location = reinterpret_cast<uintptr_t>(address);
+  auto next = registry.ranges.upper_bound(location);
+  if (next == registry.ranges.begin()) return {};
+  auto entry = std::prev(next);
+  if (location >= entry->second.end) return {};
+  auto delegate = entry->second.delegate.lock();
+  if (delegate) *offset = location - entry->first;
+  return delegate;
