+void BackingStore::SetSharedMemoryWaitDelegate(
+    std::shared_ptr<v8::SharedMemoryWaitDelegate> delegate) {
+  CHECK(is_shared());
+  CHECK(!shared_wait_delegate_);
+  CHECK_NOT_NULL(delegate.get());
