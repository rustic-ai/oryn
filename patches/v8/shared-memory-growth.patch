+void BackingStore::SetSharedMemoryGrowthDelegate(
+    std::shared_ptr<v8::SharedMemoryGrowthDelegate> delegate,
+    size_t maximum_length, size_t reserved_capacity) {
+  CHECK(is_shared());
+  CHECK(!is_wasm_memory());  // Wasm needs its allocation/guard/bounds hook.
+  CHECK(!shared_growth_delegate_);
+  CHECK_NOT_NULL(delegate.get());
+  CHECK_GE(reserved_capacity, maximum_length);
+  CHECK_GE(maximum_length, byte_length_.load(std::memory_order_relaxed));
+  CHECK_LE(maximum_length, JSArrayBuffer::kMaxByteLength);
+  const size_t current = delegate->ByteLength();
+  CHECK_LE(current, maximum_length);
+  CHECK_GE(current, byte_length_.load(std::memory_order_relaxed));
+  // Installation is only allowed before publication. The native mapping is
+  // already reserved; no V8 allocator ownership or sandbox address changes.
+  max_byte_length_ = maximum_length;
+  byte_capacity_ = reserved_capacity;
+  byte_length_.store(current, std::memory_order_relaxed);
+  shared_growth_delegate_ = std::move(delegate);
+  set_flag(kIsResizableByJs);
+}
 
