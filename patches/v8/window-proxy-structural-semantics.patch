+namespace {
+// This flag belongs to an embedder template, never an author-visible property.
+// Global proxies can carry either a template or its instantiated API function
+// as their constructor. Detached/non-API objects have no opt-in semantics.
+bool HasWindowProxyStructuralSemantics(Tagged<JSObject> object) {
+  if (!IsJSGlobalProxy(object)) return false;
+  Tagged<Object> constructor = object->map()->GetConstructor();
+  Tagged<FunctionTemplateInfo> info;
+  if (IsFunctionTemplateInfo(constructor)) {
+    info = Cast<FunctionTemplateInfo>(constructor);
+  } else if (IsJSFunction(constructor) &&
+             Cast<JSFunction>(constructor)->shared()->IsApiFunction()) {
+    info = Cast<JSFunction>(constructor)->shared()->api_func_data();
+  } else {
+    return false;
+  }
+  Tagged<Object> instance = info->GetInstanceTemplate();
+  return IsObjectTemplateInfo(instance) &&
+         Cast<ObjectTemplateInfo>(instance)->window_proxy_structural_semantics();
+}
