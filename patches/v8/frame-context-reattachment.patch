+void MicrotaskQueue::MovePendingTo(MicrotaskQueue* target) {
+  CHECK_NE(this, target);
+  CHECK(!IsRunningMicrotasks());
+  CHECK(!target->IsRunningMicrotasks());
+  for (intptr_t index = 0; index < size_; ++index) {
+    target->EnqueueMicrotask(get(index));
+  }
+  size_ = 0;
+  start_ = 0;
+}
 
