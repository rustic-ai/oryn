+Maybe<bool> Context::SuspendMicrotasks(MicrotaskQueue* supplied) {
+  auto context = Utils::OpenDirectHandle(this);
+  i::Isolate* isolate = i::Isolate::Current();
+  EnterV8NoScriptNoExceptionScope api_scope(isolate);
+  auto* active = isolate->default_microtask_queue();
+  auto* paused = static_cast<i::MicrotaskQueue*>(supplied);
+  if (!paused || paused == active || context->microtask_queue() != active ||
+      active->IsRunningMicrotasks() || active->size() != 0 ||
+      active->GetMicrotasksScopeDepth() != 0 ||
+      isolate->handle_scope_implementer()->EnteredContextCount() != 0) {
+    return Just(false);
+  }
+  context->set_microtask_queue(isolate, paused);
+  return Just(true);
+}
+
+Maybe<bool> Context::ResumeMicrotasks(MicrotaskQueue* supplied, bool discard) {
+  auto context = Utils::OpenDirectHandle(this);
+  i::Isolate* isolate = i::Isolate::Current();
+  EnterV8NoScriptNoExceptionScope api_scope(isolate);
+  auto* active = isolate->default_microtask_queue();
+  auto* paused = static_cast<i::MicrotaskQueue*>(supplied);
+  if (!paused || paused == active || context->microtask_queue() != paused ||
+      paused->IsRunningMicrotasks() || active->IsRunningMicrotasks() ||
+      isolate->handle_scope_implementer()->EnteredContextCount() != 0) {
+    return Just(false);
+  }
+  if (!discard) paused->MovePendingTo(active);
+  context->set_microtask_queue(isolate, active);
+  return Just(true);
+}
+
+void Context::DetachGlobalPreservingMicrotasks() {
+  auto context = Utils::OpenDirectHandle(this);
+  i::Isolate* isolate = i::Isolate::Current();
+  EnterV8NoScriptNoExceptionScope api_scope(isolate);
+  auto* paused = context->microtask_queue();
+  CHECK_NOT_NULL(paused);
+  CHECK_NE(paused, isolate->default_microtask_queue());
+  CHECK(!paused->IsRunningMicrotasks());
+  isolate->DetachGlobal(context);
+  context->set_microtask_queue(isolate, paused);
+}
+
+Maybe<bool> Context::ReattachGlobal(MicrotaskQueue* microtask_queue) {
+  auto context = Utils::OpenDirectHandle(this);
+  i::Isolate* i_isolate = i::Isolate::Current();
+  EnterV8NoScriptNoExceptionScope api_scope(i_isolate);
+  i::DirectHandle<i::JSGlobalProxy> proxy(context->global_proxy(), i_isolate);
+  if (!context->IsDetached() || !proxy->IsDetached()) return Just(false);
+  i::DirectHandle<i::JSFunction> function(context->global_proxy_function(),
+                                         i_isolate);
+  i::DirectHandle<i::JSGlobalObject> global(context->global_object(), i_isolate);
+  // The same native proxy object survives navigation. Reinitialize only its
+  // proxy map/embedder slots; the preserved inner global and lexical context
+  // remain intact. This is the bootstrapper's HookUpGlobalProxy operation.
+  i_isolate->factory()->ReinitializeJSGlobalProxy(proxy, function);
+  i::JSObject::ForceSetPrototype(i_isolate, proxy, global);
+  proxy->map()->set_map(i_isolate, context->meta_map());
+  global->set_global_proxy(*proxy);
+  global->set_global_proxy_for_api(*proxy);
+  context->set_global_proxy_object(*proxy);
+  auto* queue = microtask_queue
+      ? static_cast<i::MicrotaskQueue*>(microtask_queue)
+      : context->microtask_queue() ? context->microtask_queue()
+                                 : i_isolate->default_microtask_queue();
+  context->set_microtask_queue(i_isolate, queue);
+  return Just(true);
+}
