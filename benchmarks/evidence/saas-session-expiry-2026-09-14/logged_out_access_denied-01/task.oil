goto "http://127.0.0.1:62525/saas/9466c8aa4291413d1d9e46da282ab739/login"
type "Username" "agent@example.test"
type "Password" "fixture-only-password"
click "Sign in"
type "Record title" "Draft"
click "Create record"
wait visible css(#record)
extract text --selector "#record"
type "Record title" "Approved"
click "Save changes"
click "Reload record"
extract text --selector "#record"
extract text --selector "#version"
click "Sign out"
goto "http://127.0.0.1:62525/saas/9466c8aa4291413d1d9e46da282ab739/records"
extract text --selector "h1"
observe
