goto "http://127.0.0.1:62525/saas/dde7cdede509ce10a9562454a156f258/login"
type "Username" "agent@example.test"
type "Password" "fixture-only-password"
click "Sign in"
type "Record title" "Draft"
click "Create record"
wait visible css(#record)
extract text --selector "#record"
type "Record title" "Rejected edit"
click "Save changes"
extract text --selector "h1"
click "Sign in again"
type "Username" "agent@example.test"
type "Password" "fixture-only-password"
click "Sign in"
type "Record title" "Approved"
click "Save changes"
click "Reload record"
extract text --selector "#record"
extract text --selector "#version"
click "Sign out"
observe
