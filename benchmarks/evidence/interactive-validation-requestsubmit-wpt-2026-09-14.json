          {
            "message": "",
            "name": "Passing an element which is not a submit button should throw",
            "status": 0
          },
          {
            "message": "",
            "name": "Passing a submit button not owned by the context object should throw",
            "status": 0
          },
          {
            "message": "",
            "name": "requestSubmit() should accept button[type=submit], input[type=submit], and input[type=image]",
            "status": 0
          },
          {
            "message": "",
            "name": "requestSubmit() should trigger interactive form validation",
            "status": 0
          },
          {
            "message": "",
            "name": "requestSubmit() doesn't run form submission reentrantly",
            "status": 0
          },
          {
            "message": "",
            "name": "requestSubmit() doesn't run interactive validation reentrantly",
            "status": 0
          },
          {
            "message": "",
            "name": "requestSubmit() for a disconnected form should not submit the form",
            "status": 0
          },
          {
            "message": "",
            "name": "The value of the submitter should be appended, and form* attributes of the submitter should be handled.",
            "status": 0
          },
          {
            "message": "",
            "name": "The constructed FormData object should not contain an entry for the submit button that was used to submit the form.",
            "status": 0
          },
          {
            "message": "",
            "name": "Using requestSubmit on a disabled button (via disabled attribute) should trigger submit but not be visible in FormData",
            "status": 0
          }
        ]
