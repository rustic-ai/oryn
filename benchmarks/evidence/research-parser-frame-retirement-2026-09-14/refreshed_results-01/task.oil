goto "http://127.0.0.1:58031/research/8d7426d309c065eae47ea58d67f4ed4d/start"
type "Search sources" "refresh"
click "Search reports"
click "Refresh results"
wait visible css(#ready)
extract links --selector "#results"
click "Beta report"
wait visible css(#facts)
extract text --selector "#facts"
extract tables --selector "#measurements"
extract links --selector "#sources"
observe
