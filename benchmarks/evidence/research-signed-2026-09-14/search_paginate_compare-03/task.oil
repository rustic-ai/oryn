goto "http://127.0.0.1:56120/research/8650c0af9c859f9af1481e14c6d266ac/start"
type "Search sources" "energy"
click "Search reports"
click "Alpha report"
wait visible css(#facts)
extract text --selector "#facts"
extract tables --selector "#measurements"
extract links --selector "#sources"
observe
click "Back to results"
click "Next results"
click "Beta report"
wait visible css(#facts)
extract text --selector "#facts"
extract tables --selector "#measurements"
extract links --selector "#sources"
observe
