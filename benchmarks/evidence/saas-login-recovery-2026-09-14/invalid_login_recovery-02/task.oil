goto "http://127.0.0.1:62241/saas/f7430ba72c2df860f76826db1a745ddc/login"
type "Username" "agent@example.test"
type "Password" "wrong-fixture-password"
click "Sign in"
extract text --selector "h1"
click "Sign in again"
type "Username" "agent@example.test"
type "Password" "fixture-only-password"
click "Sign in"
type "Record title" "Draft"
click "Create record"
wait visible css(#record)
extract text --selector "#record"
type "Record title" "Approved"
click "Save changes"
click "Reload record"
extract text --selector "#record"
extract text --selector "#version"
click "Sign out"
observe
