goto "http://127.0.0.1:62241/saas/6c8c2dce39b7334ae44b5c3fb8e040e3/login"
type "Username" "agent@example.test"
type "Password" "fixture-only-password"
click "Sign in"
type "Record title" "Draft"
click "Create record"
wait visible css(#record)
extract text --selector "#record"
type "Record title" "Approved"
click "Save changes"
click "Reload record"
extract text --selector "#record"
extract text --selector "#version"
click "Sign out"
goto "http://127.0.0.1:62241/saas/6c8c2dce39b7334ae44b5c3fb8e040e3/records"
extract text --selector "h1"
observe
