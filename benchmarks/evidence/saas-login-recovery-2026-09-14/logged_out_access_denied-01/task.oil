goto "http://127.0.0.1:62241/saas/cac43cf910f33acbd58b8432c9c8289a/login"
type "Username" "agent@example.test"
type "Password" "fixture-only-password"
click "Sign in"
type "Record title" "Draft"
click "Create record"
wait visible css(#record)
extract text --selector "#record"
type "Record title" "Approved"
click "Save changes"
click "Reload record"
extract text --selector "#record"
extract text --selector "#version"
click "Sign out"
goto "http://127.0.0.1:62241/saas/cac43cf910f33acbd58b8432c9c8289a/records"
extract text --selector "h1"
observe
