goto "http://127.0.0.1:61255/research/5d07b5cd602fe76541df2067f12e0964/start"
type "Search sources" "dynamic"
click "Search reports"
wait visible css(#ready)
click "Alpha report"
wait visible css(#facts)
extract text --selector "#facts"
extract tables --selector "#measurements"
extract links --selector "#sources"
observe
