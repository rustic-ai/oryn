{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://oryn.dev/schemas/execution-domains-result-v1.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","gate","run_id","recorded_at","fingerprint","regressions","metrics","artifact_ledger","case_ledger","criteria","outcome"],
  "properties":{
    "schema_version":{"const":1},"gate":{"const":"G6"},"run_id":{"type":"string","minLength":1},"recorded_at":{"type":"string","format":"date-time"},
    "fingerprint":{"$ref":"#/$defs/fingerprint"},
    "regressions":{"type":"object","additionalProperties":{"enum":["passed","failed"]},"minProperties":1},
    "metrics":{"type":"object","additionalProperties":false,"required":["required_passed","required_total","domain_selections","handoffs","handoff_failures"],"properties":{"required_passed":{"const":25},"required_total":{"const":25},"domain_selections":{"type":"integer","minimum":1},"handoffs":{"type":"integer","minimum":1},"handoff_failures":{"const":0}}},
    "artifact_ledger":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/artifact"}},
    "case_ledger":{"type":"array","minItems":25,"maxItems":25,"items":{"$ref":"#/$defs/case"}},
    "criteria":{"type":"object","additionalProperties":{"type":"boolean"},"minProperties":1},
    "outcome":{"$ref":"#/$defs/outcome"}
  },
  "$defs":{
    "sha1":{"type":"string","pattern":"^[0-9a-f]{40}$"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "binary":{"type":"object","additionalProperties":false,"required":["sha256","bytes"],"properties":{"sha256":{"$ref":"#/$defs/sha256"},"bytes":{"type":"integer","minimum":1}}},
    "fingerprint":{"type":"object","additionalProperties":false,"required":["source_commit","source_tree_sha256","manifest_sha256","parent","worker","runtime"],"properties":{"source_commit":{"$ref":"#/$defs/sha1"},"source_tree_sha256":{"$ref":"#/$defs/sha256"},"manifest_sha256":{"$ref":"#/$defs/sha256"},"parent":{"$ref":"#/$defs/binary"},"worker":{"$ref":"#/$defs/binary"},"runtime":{"type":"object"}}},
    "artifact":{"type":"object","additionalProperties":false,"required":["id","path","sha256","bytes","kind"],"properties":{"id":{"type":"string"},"path":{"type":"string"},"sha256":{"$ref":"#/$defs/sha256"},"bytes":{"type":"integer","minimum":0},"kind":{"enum":["test_log","json_summary","runtime_metadata"]}}},
    "case":{"type":"object","additionalProperties":false,"required":["id","category","status","evidence"],"properties":{"id":{"type":"string"},"category":{"type":"string"},"status":{"const":"passed"},"evidence":{"type":"array","minItems":1,"items":{"type":"string"}}}},
    "outcome":{"type":"object","additionalProperties":false,"required":["status","reason_codes","diagnostics"],"properties":{"status":{"const":"passed"},"reason_codes":{"type":"array","maxItems":0},"diagnostics":{"type":"array"}}}
  }
}
