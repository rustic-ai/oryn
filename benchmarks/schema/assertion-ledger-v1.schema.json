{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oryn.dev/schemas/assertion-ledger-v1.json",
  "title": "Oryn assertion-bound raw evidence ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite", "assertions"],
  "properties": {
    "schema_version": {"const": 1},
    "suite": {"type": "string", "minLength": 1},
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/assertion"}
    }
  },
  "$defs": {
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "case_id", "status", "checks", "artifacts"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "case_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["passed", "failed", "expected_limitation"]},
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "passed", "artifact"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "passed": {"type": "boolean"},
              "artifact": {"type": "string", "minLength": 1}
            }
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "domains": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "chromium_differential": {"enum": ["passed", "not_applicable"]}
          }
        }
      }
    }
  }
}
