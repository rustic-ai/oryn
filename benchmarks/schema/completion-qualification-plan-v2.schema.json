{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "completion-qualification-plan-v2.schema.json",
  "title": "Current completion required-profile plan",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "core",
    "non_core_scope",
    "workflows",
    "profiles",
    "receipts",
    "booking_resolution"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory",
        "manifest",
        "policy",
        "checkout",
        "profiles"
      ],
      "properties": {
        "inventory": {
          "type": "string",
          "pattern": "^/"
        },
        "manifest": {
          "type": "string",
          "pattern": "^/"
        },
        "policy": {
          "type": "string",
          "pattern": "^/"
        },
        "checkout": {
          "type": "string",
          "pattern": "^/"
        },
        "profiles": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reports",
              "reviews",
              "assessments",
              "attribution",
              "disposition_applications",
              "run_contract",
              "prepared",
              "canaries",
              "placement"
            ],
            "properties": {
              "reports": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^/"
                }
              },
              "reviews": {
                "type": "string",
                "pattern": "^/"
              },
              "assessments": {
                "type": "string",
                "pattern": "^/"
              },
              "attribution": {
                "type": "string",
                "pattern": "^/"
              },
              "disposition_applications": {
                "type": "string",
                "pattern": "^/"
              },
              "run_contract": {
                "type": "string",
                "pattern": "^/"
              },
              "prepared": {
                "type": "string",
                "pattern": "^/"
              },
              "canaries": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "directory",
                  "audit"
                ],
                "properties": {
                  "directory": {
                    "type": "string",
                    "pattern": "^/"
                  },
                  "audit": {
                    "type": "string",
                    "pattern": "^/"
                  }
                }
              },
              "placement": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "directory"
                ],
                "properties": {
                  "directory": {
                    "type": "string",
                    "pattern": "^/"
                  }
                }
              }
            }
          }
        }
      }
    },
    "non_core_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflows",
        "frameworks",
        "q",
        "security",
        "architecture",
        "reliability",
        "booking_resolution",
        "native_prerequisites",
        "fixture_topology",
        "native_media"
      ],
      "properties": {
        "workflows": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "frameworks": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "q": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "security": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "architecture": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "reliability": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "booking_resolution": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "native_prerequisites": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "fixture_topology": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "native_media": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        }
      }
    },
    "workflows": {
      "type": "string",
      "pattern": "^/"
    },
    "profiles": {
      "type": "string",
      "pattern": "^/"
    },
    "receipts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frameworks",
        "security",
        "architecture",
        "reliability",
        "native-prerequisites",
        "fixture-topology",
        "native-media"
      ],
      "properties": {
        "frameworks": {
          "type": "string",
          "pattern": "^/"
        },
        "security": {
          "type": "string",
          "pattern": "^/"
        },
        "architecture": {
          "type": "string",
          "pattern": "^/"
        },
        "reliability": {
          "type": "string",
          "pattern": "^/"
        },
        "native-prerequisites": {
          "type": "string",
          "pattern": "^/"
        },
        "fixture-topology": {
          "type": "string",
          "pattern": "^/"
        },
        "native-media": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    "booking_resolution": {
      "type": "string",
      "pattern": "^/"
    },
    "booking_regression_name": {
      "type": "string",
      "minLength": 1
    }
  },
  "description": "Frozen plan records future evidence paths without cyclic candidate hashes. Exact registry membership and independent full 16737-row ledgers are required. reports retains one original and every supplied retry; canaries/placement belong to the designated original envelope. All non-Core claims identify the actual primary standard/block profile."
}
