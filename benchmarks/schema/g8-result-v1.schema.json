{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://oryn.dev/schemas/g8-result-v1.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","gate","run_id","recorded_at","fingerprint","regressions","metrics","artifact_ledger","case_ledger","criteria","outcome"],
  "properties":{
    "schema_version":{"const":1},"gate":{"const":"G8"},"run_id":{"type":"string","minLength":1},"recorded_at":{"type":"string","format":"date-time"},
    "fingerprint":{"$ref":"#/$defs/fingerprint"},
    "regressions":{"type":"object","additionalProperties":{"enum":["passed","failed"]},"required":["g1_g7_production","signed_worker","strict_software"]},
    "metrics":{"type":"object","additionalProperties":false,"required":["required_passed","required_total","display_commands","snapshot_nodes","snapshot_images","png_bytes","pdf_bytes","parent_bytes","worker_bytes","renderer_bytes"],"properties":{"required_passed":{"const":24},"required_total":{"const":24},"display_commands":{"type":"integer","minimum":4},"snapshot_nodes":{"type":"integer","minimum":1},"snapshot_images":{"type":"integer","minimum":1},"png_bytes":{"type":"integer","minimum":8},"pdf_bytes":{"type":"integer","minimum":9},"parent_bytes":{"type":"integer","minimum":1},"worker_bytes":{"type":"integer","minimum":1},"renderer_bytes":{"type":"integer","minimum":1}}},
    "artifact_ledger":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/artifact"}},
    "case_ledger":{"type":"array","minItems":24,"maxItems":24,"items":{"$ref":"#/$defs/case"}},
    "criteria":{"type":"object","additionalProperties":{"const":true},"required":["cpu_reference_renderer","screenshot_png","single_page_pdf","text_and_image_paint","truthful_diagnostics","core_dependency_boundary","signed_worker_boundary","g1_g7_regressions_pass"]},
    "outcome":{"type":"object","additionalProperties":false,"required":["status","reason_codes","diagnostics"],"properties":{"status":{"const":"passed"},"reason_codes":{"type":"array","maxItems":0},"diagnostics":{"type":"array"}}}
  },
  "$defs":{
    "sha1":{"type":"string","pattern":"^[0-9a-f]{40}$"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "binary":{"type":"object","additionalProperties":false,"required":["sha256","bytes"],"properties":{"sha256":{"$ref":"#/$defs/sha256"},"bytes":{"type":"integer","minimum":1}}},
    "fingerprint":{"type":"object","additionalProperties":false,"required":["source_commit","source_tree_sha256","manifest_sha256","parent","worker","renderer","runtime","renderer_capabilities"],"properties":{"source_commit":{"$ref":"#/$defs/sha1"},"source_tree_sha256":{"$ref":"#/$defs/sha256"},"manifest_sha256":{"$ref":"#/$defs/sha256"},"parent":{"$ref":"#/$defs/binary"},"worker":{"$ref":"#/$defs/binary"},"renderer":{"$ref":"#/$defs/binary"},"runtime":{"type":"object"},"renderer_capabilities":{"type":"object"}}},
    "artifact":{"type":"object","additionalProperties":false,"required":["id","path","sha256","bytes","kind"],"properties":{"id":{"type":"string"},"path":{"type":"string"},"sha256":{"$ref":"#/$defs/sha256"},"bytes":{"type":"integer","minimum":0},"kind":{"enum":["test_log","json_summary","runtime_metadata","image","pdf"]}}},
    "case":{"type":"object","additionalProperties":false,"required":["id","category","status","evidence"],"properties":{"id":{"type":"string"},"category":{"type":"string"},"status":{"const":"passed"},"evidence":{"type":"array","minItems":1,"items":{"type":"string"}}}}
  }
}
