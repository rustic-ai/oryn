{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oryn.dev/schema/semantic-validation-result-v5.json",
  "title": "Oryn semantic validation result v5",
  "type": "object",
  "required": ["schema_version","run_id","fingerprint","panel","metrics","cell_ledger","causal_ledger","criteria","outcome"],
  "properties": {
    "schema_version": {"const": 5},
    "run_id": {"type":"string","minLength":1},
    "fingerprint": {"type":"object","required":["sha256","source_tree_sha256"],"properties":{"sha256":{"$ref":"#/$defs/sha256"},"source_tree_sha256":{"$ref":"#/$defs/sha256"}},"additionalProperties":true},
    "panel": {"type":"object","required":["expected_runs","completed_runs","prior_hosted_spend_usd","new_hosted_spend_usd","cumulative_hosted_spend_usd","hosted_cost_cap_usd","hosted_provider","hosted_model","local_model","local_model_digest"],"additionalProperties":true},
    "metrics": {
      "type":"object",
      "required":["task_success","observation_sufficiency","causal_attribution","challenge_detection","reference_survival","false_reference_preservation"],
      "properties": {
        "task_success":{"$ref":"#/$defs/ratio"},
        "observation_sufficiency":{"$ref":"#/$defs/observationMetric"},
        "causal_attribution":{"$ref":"#/$defs/causalMetrics"},
        "challenge_detection":{"$ref":"#/$defs/challengeMetrics"},
        "reference_survival":{"$ref":"#/$defs/ratio"},
        "false_reference_preservation":{"$ref":"#/$defs/ratio"}
      },
      "additionalProperties":true
    },
    "cell_ledger":{"type":"array","maxItems":96,"items":{"$ref":"#/$defs/cell"}},
    "causal_ledger":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/causalCase"}},
    "criteria":{"type":"object","additionalProperties":{"type":"boolean"}},
    "outcome":{"type":"object","required":["panel_complete","status","reason_codes"],"properties":{"panel_complete":{"type":"boolean"},"status":{"enum":["passed","failed","attestation_pending"]},"reason_codes":{"type":"array","items":{"type":"string"}}},"additionalProperties":true}
  },
  "$defs": {
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "ratio":{"type":"object","required":["numerator","denominator","value"],"properties":{"numerator":{"type":"integer","minimum":0},"denominator":{"type":"integer","minimum":0},"value":{"type":["number","null"],"minimum":0,"maximum":1}},"additionalProperties":false},
    "observationMetric":{"type":"object","required":["numerator","denominator","value","definition","direction","attribution_counts"],"properties":{"numerator":{"type":"integer","minimum":0},"denominator":{"type":"integer","minimum":0},"value":{"type":["number","null"],"minimum":0,"maximum":1},"definition":{"const":"failed_task_projection_omission_rate"},"direction":{"const":"lower_is_better"},"attribution_counts":{"type":"object","required":["browser_truth_missing","capability_failure","model_or_action_failure","projection_omission","runtime_failure"],"additionalProperties":{"type":"integer","minimum":0}}},"additionalProperties":false},
    "failureAttribution":{"type":"object","required":["kind","checkpoint"],"properties":{"kind":{"enum":["projection_omission","browser_truth_missing","model_or_action_failure","runtime_failure","capability_failure","not_applicable"]},"checkpoint":{"type":["string","null"]},"compact_contains_required":{"type":"boolean"},"full_contains_required":{"type":"boolean"},"compact_utf8_bytes":{"type":"integer","minimum":0},"full_utf8_bytes":{"type":"integer","minimum":0},"compact_sha256":{"type":["string","null"]},"full_sha256":{"type":["string","null"]}},"additionalProperties":false},
    "cell":{"type":"object","required":["cell_id","fingerprint_sha256","completed","task_id","seed","domain","model","success","total_cost_usd","failure_attribution","action_latency_ms","observation_utf8_bytes"],"properties":{"cell_id":{"type":"string"},"fingerprint_sha256":{"$ref":"#/$defs/sha256"},"completed":{"const":true},"task_id":{"type":"string"},"seed":{"enum":[17,42,73]},"domain":{"enum":["native","chromium"]},"model":{"enum":["hosted","local"]},"success":{"type":"boolean"},"total_cost_usd":{"type":"number","minimum":0},"failure_attribution":{"$ref":"#/$defs/failureAttribution"},"action_latency_ms":{"type":"array","items":{"type":"number","minimum":0}},"observation_utf8_bytes":{"type":"array","items":{"type":"integer","minimum":0}}},"additionalProperties":false},
    "causalLabel":{"type":"object","required":["relation","kind"],"properties":{"label_id":{"type":"string"},"matched_label_id":{"type":["string","null"]},"relation":{"enum":["direct","derived","correlated","unattributed"]},"source_relation":{"enum":["direct","derived","correlated","unattributed"]},"kind":{"type":"string"},"action_id":{"type":"integer","minimum":0},"sequence":{"type":"integer","minimum":0}},"additionalProperties":false},
    "causalCase":{"type":"object","required":["case_id","expected","observed","passed"],"properties":{"case_id":{"type":"string"},"expected":{"type":"array","items":{"$ref":"#/$defs/causalLabel"}},"observed":{"type":"array","items":{"$ref":"#/$defs/causalLabel"}},"passed":{"type":"boolean"}},"additionalProperties":false},
    "causalClass":{"type":"object","required":["precision","recall"],"properties":{"precision":{"$ref":"#/$defs/ratio"},"recall":{"$ref":"#/$defs/ratio"}},"additionalProperties":false},
    "causalMetrics":{"type":"object","required":["direct","derived","correlated","unattributed_promotions"],"properties":{"direct":{"$ref":"#/$defs/causalClass"},"derived":{"$ref":"#/$defs/causalClass"},"correlated":{"$ref":"#/$defs/causalClass"},"unattributed_promotions":{"const":0}},"additionalProperties":false},
    "challengeMetrics":{"type":"object","required":["confirmed_precision","confirmed_recall"],"properties":{"confirmed_precision":{"$ref":"#/$defs/ratio"},"confirmed_recall":{"$ref":"#/$defs/ratio"}},"additionalProperties":false}
  }
}
