{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core-profile-registry-v1.schema.json",
  "title": "Reviewed required Core profile registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "revision",
    "previous_registry",
    "scope_review",
    "upstream_revision",
    "manifest_sha256",
    "policy_sha256",
    "coverage_sha256",
    "core_total",
    "primary_profile_id",
    "profiles",
    "required_profile_ids",
    "required_pairs",
    "non_core_claims"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "registry_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "previous_registry": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "scope_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author",
        "reviewer",
        "evidence",
        "requirement_sources"
      ],
      "properties": {
        "author": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "requirement_sources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "completion",
            "cookies",
            "features",
            "executor",
            "profile_scope"
          ],
          "properties": {
            "completion": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^/"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "cookies": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^/"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "features": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^/"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "executor": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^/"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "profile_scope": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^/"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    },
    "upstream_revision": {
      "const": "719d5e38fdd0903a18ed9007aba816c98cc491e0"
    },
    "manifest_sha256": {
      "const": "566f2c77524c69cc249c5fe18507ad4c11866d9077b201681b19807c4ee28101"
    },
    "policy_sha256": {
      "const": "a655bd38bbd3cc90e49344f7ceae1db1a3bfb09c8b84419b336ebf72f81eb84f"
    },
    "coverage_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "core_total": {
      "const": 16737
    },
    "primary_profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture",
          "platform",
          "processor",
          "execution_policy"
        ],
        "properties": {
          "fixture": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "platform": {
            "enum": [
              "macOS",
              "Linux",
              "Windows"
            ]
          },
          "processor": {
            "enum": [
              "aarch64",
              "x86_64"
            ]
          },
          "execution_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope",
              "renderer"
            ],
            "properties": {
              "scope": {
                "const": "entire_run"
              },
              "renderer": {
                "const": "native"
              }
            }
          }
        }
      }
    },
    "required_profile_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
      }
    },
    "required_pairs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cookies",
        "features"
      ],
      "properties": {
        "cookies": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          }
        },
        "features": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          }
        }
      }
    },
    "non_core_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflows",
        "frameworks",
        "q",
        "security",
        "architecture",
        "reliability",
        "booking_resolution",
        "native_prerequisites",
        "fixture_topology",
        "native_media"
      ],
      "properties": {
        "workflows": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "frameworks": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "q": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "security": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "architecture": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "reliability": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "booking_resolution": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "native_prerequisites": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "fixture_topology": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "native_media": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        }
      }
    }
  },
  "description": "Structural contract only. core_profile_contract.validate_registry additionally verifies actual fixture bytes, exact reviewed semantic body, independent reviewer, source pins, pair invariance, canonical paths, primary standard/block execution semantics and recursive file hashes."
}
