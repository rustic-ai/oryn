      "zone": "America/New_York",
      "fill": true,
      "recovery": false,
      "duplicate": false,
      "reservations": 1,
      "statuses": [
        303
      ],
      "steps": [
        "goto \"{base}/start\"",
        "type \"Local appointment\" \"2026-11-01T01:30\"",
        "select \"Time zone\" \"America/New_York\"",
        "wait visible css(#selection-status[data-state=\"ambiguous\"],#selection-status[data-state=\"available\"])",
        "select \"Occurrence\" \"2026-11-01T05:30:00.000Z\"",
        "click \"Review appointment\"",
        "wait visible css(#appointment-time)",
        "extract text --selector \"#appointment-time\"",
        "type \"Attendee\" \"Zo\u00eb Test\"",
        "type \"Email\" \"zoe@example.test\"",
        "click \"Reserve test appointment\"",
        "wait visible css(#reservation)",
        "click \"Reload reservation\"",
        "wait visible css(#reservation)",
        "extract text --selector \"#appointment-time\"",
        "observe"
      ],
      "client_selections": [
        {
          "local": "2026-11-01T01:30",
          "zone": "America/New_York",
          "utc": "2026-11-01T05:30:00.000Z",
