{
  "schema_version": 1,
  "family": "research_extraction",
  "scope": "controlled versioned outcomes; not full workflow or cross-origin qualification",
  "cases": [
    {
      "id": "search_paginate_compare",
      "steps": [
        "goto \"{base}/start\"",
        "type \"Search sources\" \"energy\"",
        "click \"Search reports\"",
        "click \"Alpha report\"",
        "wait visible css(#facts)",
        "extract text --selector \"#facts\"",
        "extract tables --selector \"#measurements\"",
        "extract links --selector \"#sources\"",
        "observe",
        "click \"Back to results\"",
        "click \"Next results\"",
        "click \"Beta report\"",
        "wait visible css(#facts)",
        "extract text --selector \"#facts\"",
        "extract tables --selector \"#measurements\"",
        "extract links --selector \"#sources\"",
        "observe"
      ],
      "expected": [
        "Alpha generated 11 MWh in 2025.",
        [
          [
            [
              "Year",
              "MWh"
            ],
            [
              "2025",
              "11"
            ]
          ]
        ],
        [
          {
            "text": "Canonical source",
            "href": "{base}/article/alpha"
          }
        ],
        "Beta generated 22 MWh in 2025.",
        [
          [
            [
              "Year",
              "MWh"
            ],
            [
              "2025",
              "22"
            ]
          ]
        ],
        [
          {
            "text": "Canonical source",
            "href": "{base}/article/beta"
          }
        ]
      ],
      "sources": [
        "article/alpha",
        "article/beta"
      ],
      "visits": [
        {
          "path": "start",
          "query": {},
          "status": 200
        },
        {
          "path": "search",
          "query": {
            "q": [
              "energy"
            ]
          },
          "status": 200
        },
        {
          "path": "article/alpha",
          "query": {},
          "status": 200
        },
        {
          "path": "search",
          "query": {
            "q": [
              "energy"
            ]
          },
          "status": 200
        },
        {
          "path": "search",
          "query": {
            "q": [
              "energy"
            ],
            "page": [
              "2"
            ]
          },
          "status": 200
        },
        {
          "path": "article/beta",
          "query": {},
          "status": 200
        }
      ],
      "final": "article/beta",
      "scenario": "normal"
    },
