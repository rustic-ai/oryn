{
  "schema_version": 4,
  "family": "authenticated_saas",
  "cases": [
    {
      "id": "oauth_reject_state",
      "scenario": "normal",
      "steps": [
        "goto \"{base}/negative\"",
        "click \"Test state rejection\"",
        "type \"Username\" \"agent@example.test\"",
        "type \"Password\" \"fixture-only-password\"",
        "click \"Authorize test application\"",
        "click \"Continue with altered state\"",
        "extract text --selector \"#protocol\"",
        "observe"
      ],
      "expected_extractions": [
        "state_rejected"
      ],
      "expected_authenticated": 0,
      "expected_logins": 0,
      "expected_record": null,
      "expected_requests": [],
      "expected_views": [],
      "expected_expirations": [],
      "expected_oauth": {
        "events": [
          {
            "action": "authorization_started",
            "outcome": 200
          },
          {
            "action": "code_issued",
            "outcome": 302
          },
          {
            "action": "authorized",
            "outcome": 302
          }
        ],
        "codes": [
          {
            "consumed": 0
          }
        ],
        "tokens": []
      },
      "expected_login_events": [
        {
          "action": "started",
          "outcome": 303
        },
        {
          "action": "callback_rejected",
          "outcome": 400
        }
      ],
      "expected_concurrent_edits": [],
      "final": "callback",
      "final_allow_query": true
    },
