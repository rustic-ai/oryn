{
  "schema_version": 4,
  "family": "forms",
  "cases": [
    {
      "id": "native_get",
      "scenario": "get",
      "extended": true,
      "upload": false,
      "steps": [
        "goto \"{base}/start\"",
        "type \"Full name\" \"Zo\u00eb Test\"",
        "type \"Message\" \"R\u00e9sum\u00e9 \u2713\"",
        "click \"Send document\"",
        "wait visible css(#receipt)",
        "extract text --selector \"#receipt\"",
        "observe"
      ],
      "expected_text": [
        "Document received"
      ],
      "expected_requests": [
        {
          "method": "GET",
          "path": "submit",
          "status": 303
        }
      ],
      "expected_receipts": [
        {
          "method": "GET",
          "path": "submit",
          "fields": [
            [
              "name",
              "Zo\u00eb Test"
            ],
            [
              "message",
              "R\u00e9sum\u00e9 \u2713"
            ],
            [
              "duplicate",
              "first"
            ],
            [
              "duplicate",
              "second"
            ],
            [
              "nonce",
              "{nonce}"
            ],
            [
              "intent",
              "send"
            ]
          ],
          "authorized_upload": false
        }
      ],
      "expected_accepted": 1,
      "expected_denials": []
    },
