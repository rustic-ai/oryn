{
  "schema_version": 1,
  "family": "authenticated_saas",
  "qualification": "controlled_fixture_only",
  "credential_notice": "Public synthetic fixture credentials; never use a real account.",
  "cases": [
    {
      "id": "create_update_reload_logout",
      "steps": [
        "goto \"{base}/login\"",
        "type \"Username\" \"agent@example.test\"",
        "type \"Password\" \"fixture-only-password\"",
        "click \"Sign in\"",
        "type \"Record title\" \"Draft\"",
        "click \"Create record\"",
        "wait visible css(#record)",
        "extract text --selector \"#record\"",
        "type \"Record title\" \"Approved\"",
        "click \"Save changes\"",
        "click \"Reload record\"",
        "extract text --selector \"#record\"",
        "extract text --selector \"#version\"",
        "click \"Sign out\"",
        "observe"
      ],
      "expected_extractions": [
        "Draft",
        "Approved",
        "2"
      ],
      "expected_record": {
        "title": "Approved",
        "version": 2
      },
      "expected_authenticated": 0,
      "expected_logins": 1,
      "expected_requests": [
        {
          "action": "login",
          "outcome": 303,
          "authorized": 0
        },
        {
          "action": "create",
          "outcome": 303,
          "authorized": 1
        },
        {
          "action": "update",
          "outcome": 303,
          "authorized": 1
        },
        {
          "action": "logout",
          "outcome": 303,
          "authorized": 1
        }
      ],
      "final": "login",
      "expected_views": [
        {
          "page": "login",
          "authorized": 0
        },
        {
          "page": "records",
          "authorized": 1
        },
        {
          "page": "records",
          "authorized": 1
        },
        {
          "page": "records",
          "authorized": 1
        },
        {
          "page": "records",
          "authorized": 1
        },
        {
          "page": "login",
          "authorized": 0
        }
      ]
    },
    {
      "id": "invalid_login_recovery",
      "steps": [
        "goto \"{base}/login\"",
        "type \"Username\" \"agent@example.test\"",
        "type \"Password\" \"wrong-fixture-password\"",
        "click \"Sign in\"",
        "extract text --selector \"h1\"",
        "click \"Sign in again\"",
        "type \"Username\" \"agent@example.test\"",
        "type \"Password\" \"fixture-only-password\"",
        "click \"Sign in\"",
        "type \"Record title\" \"Draft\"",
        "click \"Create record\"",
        "wait visible css(#record)",
        "extract text --selector \"#record\"",
        "type \"Record title\" \"Approved\"",
        "click \"Save changes\"",
        "click \"Reload record\"",
        "extract text --selector \"#record\"",
        "extract text --selector \"#version\"",
        "click \"Sign out\"",
        "observe"
      ],
      "expected_extractions": [
        "Invalid credentials",
        "Draft",
        "Approved",
        "2"
      ],
      "expected_record": {
        "title": "Approved",
        "version": 2
      },
      "expected_authenticated": 0,
      "expected_logins": 1,
      "expected_requests": [
        {
          "action": "login",
          "outcome": 401,
          "authorized": 0
        },
        {
          "action": "login",
          "outcome": 303,
          "authorized": 0
        },
        {
          "action": "create",
          "outcome": 303,
          "authorized": 1
        },
        {
          "action": "update",
          "outcome": 303,
          "authorized": 1
        },
        {
          "action": "logout",
          "outcome": 303,
          "authorized": 1
        }
      ],
      "final": "login",
      "expected_views": [
        {
          "page": "login",
          "authorized": 0
        },
        {
          "page": "login",
          "authorized": 0
        },
        {
          "page": "records",
          "authorized": 1
        },
        {
          "page": "records",
          "authorized": 1
        },
        {
          "page": "records",
          "authorized": 1
        },
        {
          "page": "records",
          "authorized": 1
        },
        {
          "page": "login",
          "authorized": 0
        }
      ]
    },
